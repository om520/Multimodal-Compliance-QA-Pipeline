# ─── Ollama (local LLM + embeddings) ────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ─── Local model paths ───────────────────────────────────────────────────────
# faster-whisper model size: tiny | base | small | medium | large-v2
WHISPER_MODEL=base

# HuggingFace vision captioning model
VISION_MODEL=Salesforce/blip-image-captioning-base

# ─── Video processing ────────────────────────────────────────────────────────
# Sample one frame every N seconds for vision analysis
FRAME_SAMPLE_SECONDS=10

# ─── ChromaDB (local vector store) ───────────────────────────────────────────
# Directory where ChromaDB will persist its data
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=compliance_rules

# Local evidence records for completed audits
AUDIT_RUNS_DIR=./audit_runs

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
